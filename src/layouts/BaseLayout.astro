---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import LanguageSwitcher from '../components/ui/LanguageSwitcher.astro';
import MatrixRain from '../components/ui/MatrixRain.astro';
import ScrambleHeadings from '../components/ui/ScrambleHeadings.astro';
import { glitchTransition } from '../lib/transitions.ts';
import { getPathWithoutLocale } from '../lib/locale-path.ts';
import { getDictionary } from '../i18n';

interface Props {
  title: string;
  description?: string;
}

const dict = getDictionary(Astro.currentLocale);
const { title, description = dict.seo.home } = Astro.props;

const locale: 'es' | 'ca' | 'en' =
  Astro.currentLocale === 'ca' || Astro.currentLocale === 'en' ? Astro.currentLocale : 'es';
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
// getRelativeLocaleUrl (usado abajo en hreflang y en el sitemap) siempre
// genera rutas con barra final; normalizamos aqui tambien para que la URL
// canonica y las hreflang coincidan exactamente sin importar si el
// visitante entro con o sin la barra.
const normalizedPathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(normalizedPathname, Astro.site);

const OG_LOCALES = { es: 'es_ES', ca: 'ca_ES', en: 'en_US' } as const;
const HREFLANG_LOCALES = ['es', 'ca', 'en'] as const;
---

<html lang={locale}>
  <head>
    <script is:inline>
      (function () {
        function applyTheme(doc) {
          const stored = localStorage.getItem('theme');
          if (stored === 'light') {
            doc.documentElement.dataset.theme = 'light';
          } else {
            delete doc.documentElement.dataset.theme;
          }
        }

        // Aplica el tema guardado antes del primer pintado (evita el flash).
        applyTheme(document);

        // <ClientRouter /> trae el HTML de la pagina siguiente SIN saber nada
        // de localStorage, y lo intercambia por el actual: sin este listener,
        // el tema claro se "olvidaba" al navegar a otra seccion porque el
        // <html> nuevo nunca llevaba data-theme="light". astro:before-swap
        // da acceso al documento nuevo justo antes de intercambiarlo, asi que
        // aplicamos el tema ahi tambien, sin parpadeo.
        document.addEventListener('astro:before-swap', (event) => {
          applyTheme(event.newDocument);
        });
      })();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {HREFLANG_LOCALES.map((loc) => (
      <link
        rel="alternate"
        hreflang={loc}
        href={new URL(getRelativeLocaleUrl(loc, pathWithoutLocale), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl('es', pathWithoutLocale), Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={dict.site.title} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {HREFLANG_LOCALES.filter((loc) => loc !== locale).map((loc) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[loc]} />
    ))}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <ClientRouter />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:border focus:border-accent-dim focus:bg-surface focus:px-3 focus:py-2 focus:text-accent"
    >
      {dict.common.skipToContent}
    </a>
    <MatrixRain transition:persist="matrix-rain" />
    <div
      class="fixed right-4 top-4 z-50 flex max-w-[calc(100vw-2rem)] flex-wrap items-center justify-end gap-2 sm:gap-3"
      transition:persist="top-controls"
    >
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
    <ScrambleHeadings transition:persist="scramble-headings" />
    <div id="main-content" transition:animate={glitchTransition}>
      <slot />
    </div>
  </body>
</html>
