---
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import LanguageSwitcher from '../components/ui/LanguageSwitcher.astro';
import MatrixRain from '../components/ui/MatrixRain.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang={Astro.currentLocale ?? 'es'}>
  <head>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <MatrixRain transition:persist="matrix-rain" />
    <div class="fixed right-4 top-4 z-50 flex items-center gap-3" transition:persist="top-controls">
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
    <slot />
  </body>
</html>
