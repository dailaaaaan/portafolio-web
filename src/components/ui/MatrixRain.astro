---
---

<canvas
  id="matrix-rain"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
  aria-hidden="true"
></canvas>

<script>
  const FONT_SIZE = 16;
  const CHARACTERS = 'アイウエオカキクケコサシスセソタチツテト0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';

  // canvasEl/context se re-obtienen en cada init() (ver mas abajo) en vez de
  // capturarse una sola vez al cargar el script. <ClientRouter /> marca este
  // canvas con transition:persist para que no parpadee al navegar, pero el
  // bucle de dibujo dejaba de pintar tras una navegacion (solo se arreglaba
  // recargando la pagina entera). Releer el elemento y relanzar el intervalo
  // en cada astro:page-load (se dispara tanto en la carga inicial como tras
  // cada navegacion) hace que funcione siempre, sin depender de que el mismo
  // setInterval sobreviva indefinidamente de fondo.
  let canvasEl: HTMLCanvasElement | null = null;
  let context: CanvasRenderingContext2D | null = null;

  let columns = 0;
  let drops: number[] = [];
  // Tipado explicito como "number": en el navegador window.setInterval /
  // window.setTimeout siempre devuelven number (a diferencia de Node, que
  // devuelve un objeto Timeout). El proyecto tambien tiene @types/node (para
  // el script de semillas), asi que la inferencia automatica podia
  // confundirse con el tipo de Node.
  let intervalId: number | undefined;
  let resizeTimeoutId: number | undefined;

  const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function resize() {
    if (!canvasEl) return;
    canvasEl.width = window.innerWidth;
    canvasEl.height = window.innerHeight;
    columns = Math.floor(canvasEl.width / FONT_SIZE);
    const height = canvasEl.height;
    drops = Array.from(
      { length: columns },
      () => Math.floor((Math.random() * height) / FONT_SIZE) * -1
    );
  }

  function colorVar(name: string, fallback: string) {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return value || fallback;
  }

  function draw() {
    if (!canvasEl || !context) return;

    const bgRgb = colorVar('--color-bg-rgb', '10 14 10').replaceAll(' ', ',');
    const accentRgb = colorVar('--color-accent-rgb', '57 255 106').replaceAll(' ', ',');

    context.fillStyle = `rgba(${bgRgb}, 0.06)`;
    context.fillRect(0, 0, canvasEl.width, canvasEl.height);
    context.font = `${FONT_SIZE}px ${getComputedStyle(document.body).fontFamily}`;

    for (let i = 0; i < drops.length; i++) {
      const char = CHARACTERS[Math.floor(Math.random() * CHARACTERS.length)];
      const x = i * FONT_SIZE;
      const y = drops[i] * FONT_SIZE;

      context.fillStyle = `rgba(${accentRgb}, ${Math.random() * 0.5 + 0.5})`;
      context.fillText(char, x, y);

      if (y > canvasEl.height && Math.random() > 0.975) {
        drops[i] = 0;
      }
      drops[i]++;
    }
  }

  function stop() {
    if (intervalId !== undefined) {
      window.clearInterval(intervalId);
      intervalId = undefined;
    }
  }

  function start() {
    stop();
    intervalId = window.setInterval(draw, 50);
  }

  function applyMotionPreference() {
    if (!canvasEl || !context) return;
    if (reduceMotionQuery.matches) {
      stop();
      context.clearRect(0, 0, canvasEl.width, canvasEl.height);
    } else if (document.visibilityState === 'visible') {
      start();
    }
  }

  function init() {
    stop();
    canvasEl = document.getElementById('matrix-rain') as HTMLCanvasElement | null;
    context = canvasEl?.getContext('2d') ?? null;
    if (!canvasEl || !context) return;
    resize();
    applyMotionPreference();
  }

  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimeoutId);
    resizeTimeoutId = window.setTimeout(() => {
      resize();
    }, 150);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      stop();
    } else {
      applyMotionPreference();
    }
  });

  reduceMotionQuery.addEventListener('change', applyMotionPreference);

  // astro:page-load se dispara en la carga inicial Y tras cada navegacion de
  // <ClientRouter />, asi que no hace falta llamar a init() aparte.
  document.addEventListener('astro:page-load', init);
</script>
