---
import { getDictionary } from '../../i18n';

const dict = getDictionary(Astro.currentLocale);
---

<button
  id="theme-toggle"
  type="button"
  aria-label={dict.theme.toggleLabel}
  aria-pressed="false"
  data-label-dark={dict.theme.dark}
  data-label-light={dict.theme.light}
  class="rounded border border-accent-dim px-2 py-1 font-mono text-xs text-muted transition duration-150 hover:text-accent active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <span data-theme-label>{dict.theme.dark}</span>
</button>

<script>
  const STORAGE_KEY = 'theme';
  const button = document.getElementById('theme-toggle');
  const label = button?.querySelector('[data-theme-label]');

  function currentTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function render() {
    const theme = currentTheme();
    const text = theme === 'light' ? button?.dataset.labelLight : button?.dataset.labelDark;
    if (label && text) label.textContent = text;
    button?.setAttribute('aria-pressed', String(theme === 'light'));
  }

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    localStorage.setItem(STORAGE_KEY, next);
    render();
  });

  render();
</script>
