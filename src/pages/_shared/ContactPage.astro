---
import { getDictionary } from '../../i18n';
import { getContact } from '../../content/contact';
import TerminalWindow from '../../components/ui/TerminalWindow.astro';
import BackLink from '../../components/ui/BackLink.astro';

const dict = getDictionary(Astro.currentLocale);
const contact = getContact(Astro.currentLocale);
---

<main class="min-h-screen px-4 py-16">
  <div class="mx-auto max-w-2xl">
    <h1 class="mb-6 text-center text-2xl font-bold text-fg">./{dict.nav.contact}</h1>

    <TerminalWindow promptLabel="cat contacto.json">
      <p class="mb-5 text-sm text-muted">{contact.intro}</p>

      <ul class="flex flex-col gap-3">
        {contact.links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="group flex items-baseline gap-2 rounded px-1 py-0.5 outline-none hover:bg-bg focus-visible:bg-bg"
            >
              <span class="text-accent-dim group-hover:text-accent group-focus-visible:text-accent">
                [{link.label}]
              </span>
              <span class="text-sm text-fg group-hover:text-accent group-focus-visible:text-accent">
                {link.value}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </TerminalWindow>

    <div class="mt-6 text-center">
      <BackLink />
    </div>
  </div>
</main>
