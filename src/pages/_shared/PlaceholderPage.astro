---
import { getDictionary } from '../../i18n';

interface Props {
  // Clave del diccionario nav.* a mostrar como titulo de la seccion.
  section: 'cv' | 'coverLetter' | 'experience' | 'testimonials' | 'contact';
}

const { section } = Astro.props;
const dict = getDictionary(Astro.currentLocale);
const title = dict.nav[section];
---

<main class="flex min-h-screen flex-col items-center justify-center px-4 py-16 text-fg">
  <p class="mb-2 font-mono text-sm text-accent">./{title}</p>
  <p class="font-mono text-sm text-muted">{dict.placeholder.message}</p>
</main>
