---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from './_shared/ContactPage.astro';
import { getDictionary } from '../i18n';

const dict = getDictionary(Astro.currentLocale);
---

<BaseLayout title={`${dict.nav.contact} — ${dict.site.title}`} description={dict.seo.contact}>
  <ContactPage />
</BaseLayout>
