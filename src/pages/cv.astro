---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvPage from './_shared/CvPage.astro';
import { getDictionary } from '../i18n';

const dict = getDictionary(Astro.currentLocale);
---

<BaseLayout title={`${dict.nav.cv} — ${dict.site.title}`} description={dict.seo.cv}>
  <CvPage />
</BaseLayout>
